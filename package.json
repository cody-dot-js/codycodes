{
  "name": "codycod.es",
  "private": true,
  "description": "Cody Price's personal site: posts in MDX, prerendered in the abyss brand.",
  "license": "MIT",
  "author": "Cody A. Price",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "react-router build",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev": "VITE_DRAFTS=1 react-router dev",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "react-router typegen && oxlint --type-aware --deny-warnings",
    "lint:fix": "react-router typegen && oxlint --type-aware --fix",
    "preview": "node scripts/preview.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "@ngrok/mantle": "0.93.7",
    "@phosphor-icons/react": "2.1.10",
    "@react-router/node": "8.5.1",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@react-router/dev": "8.5.1",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "estree-util-value-to-estree": "3.5.0",
    "happy-dom": "20.14.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
